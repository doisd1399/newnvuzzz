{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:ranking-period": "node --import tsx/esm test_period_ranking.ts",
    "test:company-ranking-period": "node --import tsx/esm test_company_period_ranking.ts",
    "test:driver-scope-scores": "node --import tsx/esm test_driver_scope_scores.ts",
    "test:driver-scope-gap": "node --import tsx/esm test_driver_scope_gap.ts",
    "test:company-scope": "node --import tsx/esm test_company_scope_resolution.ts",
    "test:same-competitor-canonical": "node --import tsx/esm test_driver_same_competitor_canonical_totals.ts",
    "test:profile-ranking-alignment": "node --import tsx/esm test_profile_ranking_alignment.ts",
    "test:notifications": "node --import tsx/esm test_notification_flow.ts",
    "deploy:firestore-rules": "firebase deploy --only firestore:rules",
    "test:notification-service": "node --import tsx/esm test_notification_service.ts",
    "test:notification-wiring": "node --import tsx/esm test_notification_wiring.ts",
    "test:notifications-all": "npm run test:notifications && npm run test:notification-service && npm run test:notification-wiring && npm run test:login-notification-regression",
    "test:profile-photo-approval": "node --import tsx/esm test_profile_photo_approval_regression.ts",
    "test:login-notification-regression": "node --import tsx/esm test_login_notification_regression.ts",
    "test:recruitment-photo": "node --import tsx/esm test_recruitment_photo.ts",
    "test:registration-images": "node --import tsx/esm test_registration_images.ts",
    "test:trip-history-ranking": "node --import tsx/esm test_trip_history_ranking_alignment.ts",
    "test:ranking-stable-render": "node --import tsx/esm test_ranking_stable_render.ts",
    "test:ranking-photo-warmup": "node test_ranking_photo_warmup.mjs",
    "test:ranking-startup-warmup": "node test_ranking_startup_warmup.mjs",
    "test:trip-counter": "node --import tsx/esm test_trip_sequence_counter.ts",
    "test:trip-distance": "node --import tsx/esm test_trip_distance_flow.ts",
    "test:trip-distance-integration": "node --import tsx/esm test_trip_distance_integration.ts",
    "verify:structure": "node verify-project-structure.mjs",
    "test:firestore-scope": "node test_firestore_scope_optimization.mjs",
    "test:viewport-parity": "node --import tsx/esm test_trip_viewport_parity.ts",
    "test:session-rehydration": "node test_session_rehydration_regression.mjs",
    "test:performance-polish": "node test_performance_polish_phase4a.mjs",
    "test:instant-navigation": "node test_instant_navigation_phase4a1.mjs",
    "test:seamless-navigation": "node test_seamless_navigation_phase4a2.mjs",
    "test:ultra-fast-navigation": "node test_ultra_fast_navigation_phase4a3.mjs",
    "test:performance-periods": "node --import tsx/esm test_performance_periods.ts",
    "test:profile-history-realtime": "node test_profile_history_realtime.mjs",
    "test:performance-history-scope": "node --import tsx/esm test_performance_history_scope.ts",
    "test:driver-profile-opening": "node --import tsx/esm test_driver_profile_opening_regression.ts",
    "test:driver-profile-reconciliation": "node --import tsx/esm test_driver_profile_trip_reconciliation.ts",
    "test:driver-profile-simulator-alias": "node --import tsx/esm test_driver_profile_simulator_alias_reconciliation.ts",
    "test:driver-profile-legacy-identity": "node --import tsx/esm test_driver_profile_legacy_identity_reconciliation.ts",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:full": "npm run build && npm run build:server",
    "test:startup": "node test_startup_immediacy.mjs",
    "sanitize:firebase": "node sanitize-firebase.mjs",
    "test:simulator-selector": "node --import tsx/esm test_simulator_selector_aliases.ts",
    "test:company-profile-global": "node --import tsx/esm test_company_profile_global_ranking.ts",
    "test:company-profile-simulator-consistency": "node test_company_profile_simulator_consistency.mjs",
    "test:ranking-page-all-simulators": "node test_ranking_page_all_simulators_scope.mjs",
    "test:navigation-click": "node test_navigation_click_regression.mjs",
    "test:ranking-interaction-performance": "node --import tsx/esm test_ranking_interaction_performance.ts",
    "test:navigation-render-stability": "node test_navigation_render_stability.mjs",
    "test:role-transition": "node test_role_transition_no_white_flash.mjs",
    "test:initial-boot": "node test_initial_boot_single_nvu.mjs",
    "test:deploy-recovery": "node test_deploy_recovery.mjs",
    "test:environment-parity": "node --import tsx/esm test_environment_parity.ts",
    "test:identity-isolation": "node --import tsx/esm test_identity_isolation_regression.ts",
    "test:date-range-timezone": "node --import tsx/esm test_date_range_timezone_regression.ts",
    "test:logout-teardown": "node --import tsx/esm test_logout_teardown_regression.ts",
    "verify:environment-artifacts": "node scripts/verify-environment-parity.mjs",
    "verify:capacitor-remote": "node scripts/verify-capacitor-remote.mjs",
    "verify:netlify": "node scripts/verify-netlify-parity.mjs",
    "sync:android": "npm run build && node scripts/clean-capacitor-web-assets.mjs && npx cap sync android && npm run verify:environment-artifacts && npm run verify:capacitor-remote",
    "prepare:release": "npm run lint && npm run test:identity-isolation && npm run test:date-range-timezone && npm run test:logout-teardown && npm run test:deploy-recovery && npm run test:environment-parity && npm run test:viewport-parity && npm run test:notifications-all && npm run sync:android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/push-notifications": "^8.0.0",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-medium-image-zoom": "^5.4.6",
    "react-photo-view": "^1.2.7",
    "react-router-dom": "^7.14.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "firebase-tools": "^15.23.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  }
}
