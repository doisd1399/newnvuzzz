rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSenior() {
      return isAuthenticated() && (
        ('role' in getUserData() && getUserData().role == 'senior') ||
        ('roles' in getUserData() && getUserData().roles.hasAny(['senior']))
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSenior() ||
        ('role' in getUserData() && getUserData().role == 'admin') ||
        ('roles' in getUserData() && getUserData().roles.hasAny(['admin']))
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCompanyOwner(companyId) {
      let company = get(/databases/$(database)/documents/frotas/$(companyId)).data;
      return company != null && company.userId == request.auth.uid;
    }

    // TEMPORARY COMPATIBILITY MODE (legacy Senior password 9173).
    // Firestore Rules cannot inspect the browser's password or sessionStorage.
    // Until the shared password is replaced with Firebase custom claims, the
    // signed-in account is allowed to execute the Senior workflow. Remove this
    // function and restore role-based checks during the security hardening pass.
    function hasLegacySeniorPanelAccess() {
      return isAuthenticated();
    }

    function hasUserEmail() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().email is string;
    }

    function isRegistrationOwner() {
      return isAuthenticated() && (
        (resource.data.userId is string &&
          resource.data.userId == request.auth.uid) ||
        (resource.data.email is string &&
          request.auth.token.email != null &&
          resource.data.email == request.auth.token.email) ||
        (resource.data.email is string &&
          hasUserEmail() &&
          resource.data.email == getUserData().email)
      );
    }

    function validCompanyRegistration() {
      return 'type' in request.resource.data &&
        request.resource.data.type == 'company_registration' &&
        'companyName' in request.resource.data && request.resource.data.companyName is string &&
        'ownerName' in request.resource.data && request.resource.data.ownerName is string &&
        'email' in request.resource.data && request.resource.data.email is string &&
        (('simulatorId' in request.resource.data && request.resource.data.simulatorId is string) ||
          ('simulatorName' in request.resource.data && request.resource.data.simulatorName is string)) &&
        'status' in request.resource.data && request.resource.data.status == 'pending';
    }

    // 1. users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Allowed for initial setup
      allow update: if hasLegacySeniorPanelAccess() || isOwner(userId) || isSenior() || isAdmin();
      allow delete: if hasLegacySeniorPanelAccess() || isSenior();
    }

    // 2. frotas (companies)
    match /frotas/{id} {
      allow read: if true;
      allow create: if isAuthenticated(); 
      allow update, delete: if hasLegacySeniorPanelAccess() ||
        resource.data.userId == request.auth.uid ||
        isSenior() ||
        isAdmin();
    }

    // 3. veiculos
    match /veiculos/{id} {
      allow read: if isAuthenticated();
      allow write: if hasLegacySeniorPanelAccess() || isSenior() || isAdmin();
    }

    // 4. reboques
    match /reboques/{id} {
      allow read: if isAuthenticated();
      allow write: if hasLegacySeniorPanelAccess() || isSenior() || isAdmin();
    }

    // 5. contratos
    match /contratos/{id} {
      allow read: if isAuthenticated();
      allow write: if hasLegacySeniorPanelAccess() || isSenior() || isAdmin();
    }

    // English aliases still used by the historical trip repository.
    match /vehicles/{id} {
      allow read: if isAuthenticated();
      allow write: if hasLegacySeniorPanelAccess() || isSenior() || isAdmin();
    }

    match /trailers/{id} {
      allow read: if isAuthenticated();
      allow write: if hasLegacySeniorPanelAccess() || isSenior() || isAdmin();
    }

    match /contracts/{id} {
      allow read: if isAuthenticated();
      allow write: if hasLegacySeniorPanelAccess() || isSenior() || isAdmin();
    }

    match /sequencias/{id} {
      allow read: if isAuthenticated();
      allow write: if hasLegacySeniorPanelAccess() || isSenior() || isAdmin();
    }

    // 6. trabalhos
    match /trabalhos/{id} {
      allow read, write: if isAuthenticated();
    }

    // 7. solicitacoes_motoristas
    match /solicitacoes_motoristas/{id} {
      allow read, write: if isAuthenticated();
    }

    // 8. notificações internas (coleção atual + legado)
    // O cliente cria avisos em nome do usuário autenticado (actorUserId).
    // A leitura e a marcação como lida ficam restritas ao destinatário.
    match /notifications/{id} {
      allow create: if hasLegacySeniorPanelAccess() || (isAuthenticated() &&
        request.resource.data.userId is string &&
        (
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.actorUserId == request.auth.uid
        ));
      allow read: if hasLegacySeniorPanelAccess() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if hasLegacySeniorPanelAccess() || (isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId);
      allow delete: if hasLegacySeniorPanelAccess() || (isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isSenior() || isAdmin()));
    }

    match /notificacoes/{id} {
      allow create: if hasLegacySeniorPanelAccess() || isAuthenticated();
      allow read: if hasLegacySeniorPanelAccess() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if hasLegacySeniorPanelAccess() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if hasLegacySeniorPanelAccess() || (isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isSenior() || isAdmin()));
    }

    match /userDevices/{id} {
      allow create, update: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow read, delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // 9. jobDemands
    match /jobDemands/{id} {
      allow read: if isAuthenticated();
      allow write: if hasLegacySeniorPanelAccess() || isSenior() || isAdmin();
    }

    // 10. recruitment_applications
    match /recruitment_applications/{id} {
      // Company registration is the only intentionally public create flow.
      // Driver applications must come from an authenticated candidate.
      allow create: if validCompanyRegistration() ||
        (isAuthenticated() && (!('type' in request.resource.data) || request.resource.data.type != 'company_registration'));
      // The temporary legacy access function keeps the Senior panel usable
      // while the shared password mode is active. Replace it with a custom
      // claim before tightening these mixed-collection queries again.
      allow read: if hasLegacySeniorPanelAccess() || isAdmin() || isRegistrationOwner();
      allow update, delete: if hasLegacySeniorPanelAccess() || (
        ('type' in resource.data && resource.data.type == 'company_registration' && isSenior()) ||
        ((!('type' in resource.data) || resource.data.type != 'company_registration') && isAdmin())
      );
    }

    // 11. company_registrations
    match /company_registrations/{id} {
      allow create: if validCompanyRegistration();
      allow read, update, delete: if hasLegacySeniorPanelAccess() || isSenior() || isRegistrationOwner();
    }

    // 12. companyMembers
    match /companyMembers/{id} {
      allow read, write: if isAuthenticated();
    }

    // 12b. simulator_members
    match /simulator_members/{id} {
      allow read, write: if isAuthenticated();
    }
    
    // 13. historico_viagens
    match /historico_viagens/{tripId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.motoristaId ||
        request.auth.uid == resource.data.criadoPor ||
        isCompanyOwner(resource.data.empresaId) ||
        isSenior() ||
        isAdmin() ||
        (request.auth.token.role != null && request.auth.token.role in ["admin", "owner"] && request.auth.token.empresaId == resource.data.empresaId) ||
        hasLegacySeniorPanelAccess()
      );
    }
    

    match /simulators/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    // Default fallback
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isSenior();
    }
  }
}
